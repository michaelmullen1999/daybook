rules_version = '2';
// Who can use Brian's Daybook.
// - Owners (below) can always get in with Google sign-in.
// - Other family get in once an owner or family member adds their Google email on the family page (People tab).
// - Brian's devices get in once someone types the device's code on the family page (People tab).
service cloud.firestore {
  match /databases/{database}/documents {
    function email()    { return request.auth.token.email.lower(); }
    function google()   { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner()  { return google() && email() in ['mickmullen1999@gmail.com']; }
    function isFamily() { return isOwner() || (google() && exists(/databases/$(database)/documents/family/$(email()))); }
    function isBrian()  { return request.auth != null && exists(/databases/$(database)/documents/devices/$(request.auth.uid)); }
    function anyone()   { return isBrian() || isFamily(); }

    match /settings/{doc}  { allow read: if anyone(); allow write: if isFamily(); }
    match /appts/{id}      { allow read: if anyone(); allow write: if isFamily(); }
    match /logs/{id}       { allow read, create, delete: if anyone(); allow update: if isFamily(); }
    match /hobbies/{id}    { allow read, write: if anyone(); }
    match /todos/{id}      { allow read, write: if anyone(); }

    match /family/{em}     { allow read, write: if isFamily(); }
    match /devices/{uid}   { allow read: if isFamily() || (request.auth != null && request.auth.uid == uid);
                             allow write: if isFamily(); }
    // A new device posts its code here; family reads it to connect the device.
    match /pairing/{code}  { allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                                           && request.resource.data.keys().hasOnly(['uid', 'created']);
                             allow read, delete: if isFamily(); }

    match /{document=**}   { allow read, write: if false; }
  }
}
